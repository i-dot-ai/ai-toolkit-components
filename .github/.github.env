# github specific
EC2_INSTANCE_TYPE=t3.large
RUNNER_SIZE=large

# App related
APP_NAME={{ cookiecutter.app_name }}
REPO={{ cookiecutter.app_name }}
VERSION=v1

# ECR Repo Name (comma seperated values)
DOCKER_BUILD_INSTANCE={{ cookiecutter.app_name }}
{% if cookiecutter.frontend_framework != "None" and cookiecutter.backend_framework != "None" %}
ECR_REPO={{ cookiecutter.app_name }}-backend,{{ cookiecutter.app_name }}-frontend
SERVICE=frontend,backend
{% elif cookiecutter.backend_framework != "None" %}
ECR_REPO={{ cookiecutter.app_name }}-backend
SERVICE=backend
{% elif cookiecutter.frontend_framework != "None" %}
ECR_REPO={{ cookiecutter.app_name }}-frontend
SERVICE=frontend
{% endif %}